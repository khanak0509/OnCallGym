{
  "name": "oncallgym",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/home/dev/OnCallGym",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/OnCallGym,type=bind",
  "runArgs": ["--memory=6g", "--pids-limit=2048", "--cpus=6"],
  "containerEnv": { "UV_PROJECT_ENVIRONMENT": "/opt/venv" },
  "postCreateCommand": "uv sync",
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] } }
}
